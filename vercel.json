{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{fonts/**,node_modules/ffmpeg-static/ffmpeg,node_modules/ffmpeg-static/package.json,node_modules/ffmpeg-static/index.js}"
    }
  },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api" }],
  "crons": [{ "path": "/api/worker/cron", "schedule": "0 8 * * *" }]
}
