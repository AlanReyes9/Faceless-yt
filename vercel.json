{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{fonts/**,models/**,node_modules/ffmpeg-static/{ffmpeg,index.js,package.json},node_modules/onnxruntime-web/dist/{ort.node.min.js,ort-wasm-simd-threaded.mjs,ort-wasm-simd-threaded.wasm}}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/worker/cron",
      "schedule": "0 8 * * *"
    }
  ]
}
