# Contraseña para entrar al estudio (MUY recomendable si está en internet)
APP_PASSWORD=cambia-esto
# Clave maestra para cifrar tus claves API (genera una con: openssl rand -hex 32). Obligatoria en Vercel.
APP_SECRET=
# Postgres (Neon). Si se deja vacío se usa una base de datos local en DATA_DIR.
DATABASE_URL=
# Vercel Blob para guardar vídeos. Si se deja vacío se usa el disco local.
BLOB_READ_WRITE_TOKEN=
# URL pública (login de YouTube y worker), p. ej. https://estudio.midominio.com
PUBLIC_URL=
PORT=3000
DATA_DIR=./data
# Trabajos de render simultáneos en el servidor local
JOB_CONCURRENCY=1
# Velocidad/calidad de x264: ultrafast, veryfast, medium...
X264_PRESET=veryfast
OPENAI_BASE_URL=   # opcional: API compatible con OpenAI (p. ej. un modelo local)
