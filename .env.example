# Puerto del servidor
PORT=3000
# Contraseña para entrar al estudio (MUY recomendable en un VPS)
APP_PASSWORD=cambia-esto
# Clave maestra para cifrar tus claves API (genera una con: openssl rand -hex 32)
APP_SECRET=
# URL pública (para el login de YouTube), p. ej. https://estudio.midominio.com
PUBLIC_URL=
# Carpeta de datos (base de datos, vídeos subidos y renders)
DATA_DIR=./data
# Renders simultáneos (1 en un VPS pequeño)
JOB_CONCURRENCY=1
# Velocidad/calidad de x264: ultrafast, veryfast, medium...
X264_PRESET=veryfast
# Fuente de los subtítulos (debe estar instalada en el sistema)
FONT_NAME=DejaVu Sans
