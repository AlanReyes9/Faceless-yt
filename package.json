{
  "name": "faceless-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Estudio web para canales faceless: convierte vídeos largos en Shorts, genera vídeos completos con IA y publica en YouTube usando tus propias claves API.",
  "scripts": {
    "start": "node --no-warnings server/index.js",
    "dev": "node --no-warnings --watch server/index.js",
    "worker": "WORKER=1 node --no-warnings server/worker.js",
    "vercel-build": "node node_modules/ffmpeg-static/install.js && node -e \"const f=require('ffmpeg-static');require('fs').accessSync(f);console.log('ffmpeg OK:',f)\""
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.6",
    "archiver": "^7.0.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "multer": "^2.0.2",
    "pg": "^8.23.1"
  },
  "allowScripts": {
    "ffmpeg-static": true
  }
}
